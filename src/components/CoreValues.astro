---
import DynamicIcon from "@helpers/DynamicIcon.astro";
import ArrowRight from "@icons/arrow--right.svg";
import { getCoreValues } from "@lib/api";

const coreValues = await getCoreValues();

const isAbout = Astro.url.pathname.startsWith("/about");
---

<section class:list={["core-values", { light: isAbout }]}>
  <div class="values-inner">
    <div class="values-heading">
      <div class="heading-text">
        <p class="eyebrow">{coreValues.eyebrow}</p>
        <h2>{coreValues.title}</h2>
        <p>{coreValues.subtitle}</p>
      </div>

      <a class="contact-button" role="button" aria-disabled="true">
        {coreValues.button.text}
      </a>
    </div>

    <div class="values-grid">
      {coreValues.values.map((value) => (
        <article class="value-card">
          <div class="value-icon">
            <DynamicIcon name={value.icon} width={24} height={24} />
          </div>

          <h3>{value.title}</h3>
          <p>{value.description}</p>

          <a role="button" aria-disabled="true">
            {value.link.text} <ArrowRight width={20} height={18} aria-hidden="true" />
          </a>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  @layer components {
    .core-values {
      background-color: var(--color-neutrals-900);
      background-image:
        linear-gradient(rgb(255 255 255 / 0.025) 1px, transparent 1px),
        linear-gradient(90deg, rgb(255 255 255 / 0.025) 1px, transparent 1px);
      background-size: 32px 32px;
      color: white;
      padding-block: var(--space-section);
    }

    .core-values.light {
      background: var(--color-surface-secondary);
      color: var(--color-text);
    }

    .values-inner {
      max-width: var(--content-width);
      margin-inline: auto;
      padding-inline: var(--page-gutter);
    }

    .values-heading {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-medium);
      margin-bottom: var(--space-medium);
    }

    .heading-text {
      max-width: 55ch;
    }

    .eyebrow {
      font-size: var(--font-size-label);
      text-transform: uppercase;
      letter-spacing: 0.1em;
      margin-bottom: var(--space-small);
    }

    h2 {
      font-size: var(--font-size-heading-medium);
      margin-block: 0 var(--space-small);
    }

    .heading-text > p:last-child {
      margin-bottom: 0;
    }

    .contact-button {
      display: inline-block;
      background: white;
      color: var(--color-neutrals-900);
      padding: 0.85rem 1.5rem;
      border-radius: var(--radius-pill);
      text-decoration: none;
      font-weight: bold;
    }

    .light .contact-button {
      background: var(--color-neutrals-900);
      color: white;
    }

    .values-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1.25rem;
    }

    .value-card {
      min-width: 0;
      background: var(--color-surface-primary);
      color: var(--color-text);
      padding: 1.5rem;
      border-radius: var(--radius-large);
      overflow-wrap: anywhere;
    }

    .value-icon {
      display: grid;
      place-items: center;
      width: 48px;
      height: 48px;
      margin-bottom: var(--space-small);
      background: var(--color-neutrals-900);
      color: white;
      border-radius: 50%;
    }

    .value-icon :global(svg) {
      display: block;
    }

    h3 {
      font-size: var(--font-size-heading-small);
      margin-block: 0 var(--space-small);
    }

    .value-card p {
      color: var(--color-text-muted);
      font-size: 0.9375rem;
    }

    .value-card a {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      font-weight: bold;
      text-decoration: none;
      text-underline-offset: 0.2em;
    }

    @media (max-width: 850px) {
      .values-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media (max-width: 500px) {
      .core-values {
        padding-block: 3rem;
      }

      .values-grid {
        grid-template-columns: 1fr;
      }
    }
  }
</style>
