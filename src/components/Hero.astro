---
import { Image } from "astro:assets";
import CEOImage from "@assets/images/ceo.webp";
import ArrowRight from "@icons/arrow--right.svg";
import Services from "./Services.astro";
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-background">
    <div class="hero-content">
      <div class="hero-text">
        <h1 id="hero-title">Empowering Your Business Growth</h1>
        <p>
          Discover tailored strategies and expert insights to take your business
          to the next level. Let us help you navigate challenges and achieve
          sustainable success.
        </p>

        <div class="buttons">
          <a class="primary-button" role="button" aria-disabled="true">Book a Meeting</a>
          <a class="secondary-button" role="button" aria-disabled="true">
            Learn More
            <ArrowRight width={20} height={18} aria-hidden="true" />
          </a>
        </div>
      </div>

      <Image
        class="hero-image"
        src={CEOImage}
        alt="Sarah Jasmine, business consultant"
        loading="eager"
      />
    </div>
  </div>

  <Services />
</section>

<style>
  @layer components {
    .hero {
      background: var(--color-surface-primary);
    }

    .hero-background {
      overflow: hidden;
      background: var(--color-neutrals-900);
      color: white;
    }

    .hero-content {
      max-width: var(--content-width);
      margin-inline: auto;
      padding-inline: var(--page-gutter);

      display: grid;
      grid-template-columns: 1fr 1fr;
      align-items: center;
      gap: 3rem;
    }

    .hero-text {
      min-width: 0;
      padding-block: 4rem 6rem;
    }

    h1 {
      max-width: 15ch;
      margin-bottom: 1.25rem;
      font-size: var(--font-size-heading-large);
    }

    h1 {
      position: relative;
    }
    h1::after {
      content: "";
      position: absolute;
      right: 0;
      top: 1.1em;
      width: 100vw;
      height: 2px;
      background: var(--color-action);
    }

    .hero-text p {
      max-width: 48ch;
      margin-bottom: 1.75rem;
      color: var(--color-neutrals-400);
    }

    .hero-image {
      width: 100%;
      height: 460px;
      object-fit: cover;
      object-position: center;
      align-self: stretch;
    }

    .buttons {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
    }

    .buttons a {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.75rem;

      padding: 0.85rem 1.5rem;
      border-radius: var(--radius-pill);
      font-size: 0.875rem;
      text-decoration: none;
    }

    .primary-button {
      border: 1px solid var(--color-action);
      background: var(--color-action);
      color: var(--color-text);
    }

    .primary-button:hover {
      background: var(--color-action-hover);
    }

    .secondary-button {
      border: 1px solid var(--color-neutrals-700);
      color: white;
    }

    .secondary-button:hover {
      background: var(--color-neutrals-700);
    }

    @media (max-width: 750px) {
      .hero-content {
        grid-template-columns: 1fr;
        gap: 0;
      }

      .hero-text {
        padding-block: 3rem 2rem;
      }

      .hero-image {
        height: 350px;
        object-position: center 25%;
      }
    }
  }
</style>
